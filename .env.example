# Environment Variables Template
# Copy this file to .env and fill in your actual values

# ============================================
# DATABASE
# ============================================
# PostgreSQL connection string (Neon, Vercel Postgres, etc.)
DATABASE_URL=postgresql://user:password@host:5432/database

# ============================================
# APPLICATION URLs
# ============================================
# Your application URL
# Development: http://localhost:3000
# Production: https://your-domain.vercel.app or https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# GOOGLE OAUTH
# ============================================
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Should match: ${NEXT_PUBLIC_APP_URL}/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ============================================
# EMAIL (SMTP)
# ============================================
# SMTP server configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
# For Gmail, use an app-specific password: https://myaccount.google.com/apppasswords
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password

# Optional: Override from email and name
SMTP_FROM=noreply@yourdomain.com
SMTP_FROM_NAME=Brainy

# ============================================
# APPLICATION SETTINGS
# ============================================
# Environment (automatically set by Vercel in production)
NODE_ENV=development

# Cookie domain for production (e.g., .yourdomain.com)
# Leave empty for development
COOKIE_DOMAIN=

# ============================================
# OPTIONAL: RATE LIMITING (if using Upstash)
# ============================================
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
